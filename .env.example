# Copy this file to ".env" (same folder as the app) and fill in the real key.
# NEVER commit the real .env file to version control.

# Company Anthropic API key (required)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides -------------------------------------------------------
# Claude model to use. Leave as-is unless instructed otherwise.
ANTHROPIC_MODEL=claude-opus-5

# Reasoning effort: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
